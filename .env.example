# Application
APP_NAME=BrandMarket API
# On a server use APP_ENV=production: docs are hidden, mock payments are off and a
# strong SECRET_KEY is required (the API refuses to start otherwise).
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Demo accounts with public passwords (scripts/seed.py) are created by the Docker
# entrypoint only when this is true. Never enable on a server.
SEED_DEMO_DATA=false

# Security
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
# Optional dedicated key for TOTP secret encryption (falls back to SECRET_KEY)
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Brand Market
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TWO_FA_CHALLENGE_EXPIRE_MINUTES=5
BCRYPT_ROUNDS=12
# Proxy headers (CF-Connecting-IP / X-Forwarded-For) are used only for requests that
# come from an internal address (cloudflared, reverse proxy). Do not expose port 8000
# to the internet directly.
TRUST_PROXY_HEADERS=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:8080,http://127.0.0.1:8080

# Database
DATABASE_URL=postgresql+asyncpg://brandmarket:brandmarket@127.0.0.1:5433/brandmarket

# Redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_2FA_VERIFY_PER_MINUTE=10
RATE_LIMIT_2FA_SETUP_PER_MINUTE=5
RATE_LIMIT_PASSWORD_FORGOT_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=brandmarket
S3_REGION=us-east-1
S3_USE_SSL=false
# auto = S3, local folder while S3 is down (files then live only in the container);
# s3 = S3 only (uploads fail with 503 while S3 is down); local = local folder only.
STORAGE_BACKEND=auto
# Public URL for the browser (not the internal S3 endpoint).
# Local MinIO: http://localhost:9000/brandmarket
# Render + Cloudflare R2: https://pub-XXXX.r2.dev  (or a custom domain)
# Local disk fallback (host-mapped API port): http://localhost:8080
FILES_BASE_URL=http://localhost:9000/brandmarket
# Fallback local storage when S3 unavailable
LOCAL_UPLOAD_DIR=./uploads

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Payments: mock | alif (Marketplace when ALIF_TEST_MERCHANT_1/2 are set)
PAYMENT_PROVIDER=mock
# Alif Marketplace: https://docs.acquiring.alif.tj/marketplace
# Test: https://test-web.alif.tj  Prod: https://web.alif.tj
ALIF_BASE_URL=https://test-web.alif.tj
ALIF_TERMINAL_KEY=
ALIF_TERMINAL_PASSWORD=
ALIF_GATE=korti_milli
ALIF_CURRENCY=TJS
ALIF_TIMEOUT_SECONDS=15
# Seller terminals for mpTerminalInfo (supplier share / platform commission).
# Test merchants from bank: 610184 (supplier) + 841418 (platform). Key of marketplace = ALIF_TERMINAL_KEY.
ALIF_TEST_MERCHANT_1=
ALIF_TEST_MERCHANT_2=
# Public HTTPS base for Alif callbacks (bank must use this path):
#   {PUBLIC_API_URL}/api/v1/payments/alif/callback
# Bank callback (prod tunnel): https://api-b2b.jupiter.tj/api/v1/payments/alif/callback
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4000

# SMTP (password reset and notification emails). Without SMTP_HOST + SMTP_FROM_EMAIL
# emails are only logged (in development the body with the reset link is logged too).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Brand Market
# STARTTLS (port 587)
SMTP_USE_TLS=true
# Implicit SSL (port 465); set SMTP_USE_TLS=false when enabled
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
# Password reset link lifetime (reset link is {FRONTEND_URL}/reset-password?token=...)
PASSWORD_RESET_TTL_MINUTES=60

# Cloudflare Tunnel — токен в корневом .env (см. ../docker-compose.tunnel.yml)
# Public hostname: api.b2b.jupiter.tj → http://backend:8000
# CLOUDFLARE_TUNNEL_TOKEN=

# --- docker-compose (substituted into docker-compose.yml; required, no defaults) ---
# Use URL-safe random values: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# An existing postgres volume keeps the password it was created with: set the
# current one here first, then rotate it with ALTER USER if needed.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=brandmarket
MINIO_ROOT_PASSWORD=
# Host address the API port is published on. Cloudflare Tunnel reaches backend:8000
# inside the docker network, so the default keeps it off the public interface.
API_BIND=127.0.0.1

# Client IP for rate limits: CF-Connecting-IP is trusted from internal peers
# (Cloudflare Tunnel). Behind nginx or another proxy without Cloudflare set false.
TRUST_CF_CONNECTING_IP=true
