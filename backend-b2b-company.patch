+        return {}
+    found = await conn.fetch(
+        """
+        SELECT
+            u.id AS user_id,
+            a.id AS actor_id,
+            NULLIF(TRIM(CONCAT_WS(' ', u.first_name, u.last_name)), '') AS name,
+            cu.role::text AS role,
