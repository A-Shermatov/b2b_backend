+import ipaddress
+
 from starlette.requests import Request
 
 
+def _parse_ip(value: str | None):
+    try:
+        return ipaddress.ip_address((value or "").strip())
+    except ValueError:
+        return None
+
+
+def _is_internal(ip) -> bool:
+    return ip.is_private or ip.is_loopback or ip.is_link_local
